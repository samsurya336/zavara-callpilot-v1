# Copy to supabase/functions/.env for local `supabase functions serve`. Remote: `supabase secrets set`.
ELEVENLABS_API_KEY=
# Used when a participant has no voice_configs.voiceId.
ELEVENLABS_DEFAULT_VOICE_ID=
# Signing secret shown when the post-call webhook is created in ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=
