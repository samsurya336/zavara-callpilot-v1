# Copy to supabase/functions/.env for local `supabase functions serve`. Remote: `supabase secrets set`.
# AgenticOrg agents (https://agenticorg.hackathon.pinelabs.com). Prompts live in prompts/.
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# Agent configured with prompts/challenge-generation/system-prompt.md.
AGENTICORG_CHALLENGE_AGENT_ID=
# Generated challenges per account per day (each run creates 3). Defaults to 15.
CHALLENGE_GENERATION_DAILY_LIMIT=15
# Optional ElevenLabs voice IDs for generated buyers, as a JSON array or comma-separated list.
ELEVENLABS_VOICE_POOL=
ELEVENLABS_API_KEY=
# Used when a participant has no voice_configs.voiceId.
ELEVENLABS_DEFAULT_VOICE_ID=
# Signing secret shown when the post-call webhook is created in ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=
# JSON array of low-cost Gemini extraction keys, for example ["key-1","key-2"].
GEMINI_API_KEYS=[]
