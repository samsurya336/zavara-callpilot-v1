{
  "name": "client-console",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase": "supabase --workdir ../..",
    "supabase:start": "pnpm supabase start",
    "supabase:stop": "pnpm supabase stop",
    "supabase:env": "node ../../scripts/setup-local-supabase.mjs",
    "supabase:test": "node ../../scripts/supabase-smoke.mjs",
    "supabase:migrate": "pnpm supabase db push --local",
    "supabase:types": "supabase --workdir ../.. gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "supabase:functions": "pnpm supabase functions serve"
  },
  "dependencies": {
    "@elevenlabs/react": "1.16.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
